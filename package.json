{
  "name": "dsh-openviking-console",
  "version": "0.1.0",
  "description": "OpenViking Studio console panel for DeepSeek Harness (preview)",
  "license": "AGPL-3.0-only",
  "author": "zrwangems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrwangems/dsh-openviking-console.git"
  },
  "homepage": "https://github.com/zrwangems/dsh-openviking-console#readme",
  "bugs": {
    "url": "https://github.com/zrwangems/dsh-openviking-console/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "openviking",
    "console",
    "plugin",
    "bundle"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client-ui.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "console.mjs",
    "client-ui.mjs",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/architecture.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
